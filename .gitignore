tmp/
.scratch/

# Local WebUI fixtures / screenshots / manual-test assets (not committed)
web/local/

# Local state backups
.local-state-backups/
*.local-state-backup/

# Coverage artifacts
lcov.info

# IDE's stuff
.idea

# Wrangler cache
.wrangler/

# Docker dev workspace (runtime-generated by the agent)
playground/

# Temporary rustc output
rust_out

# Auto-generated Tauri schemas
apps/tauri/gen/schemas/

# Generated TypeScript client (rebuild via cargo web gen-api)
web/src/lib/api-generated.ts
web/src/lib/api-descriptions.ts
web/src/lib/api-enums.ts

# Generated OpenAPI spec (transient handoff for openapi-typescript)
target/openapi.json
/v[0-9]*.toml
.worktrees/
.zero-to-5/

# Collected distributable binaries (scripts/dev/collect-dist.sh)
/dist/bin/

# Reasonix agent workspace
.reasonix/

# WorkBuddy AI workspace (machine-local agent state: memory, reports, caches)
/.workbuddy-ai/
